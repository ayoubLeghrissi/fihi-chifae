# Copy to .env for local runs — never commit .env.
# On Railway, set these as service Variables instead.

# Production mode: refuses to start without FIHI_ADMIN_PASSWORD on a fresh database,
# trusts the platform proxy for client IPs, marks cookies Secure.
FIHI_ENV=production

# Persistent data directory = the mounted volume (both SQLite databases + uploads)
FIHI_DATA_DIR=/data

# Admin account (only used to create it the first time the database is empty)
FIHI_ADMIN_USER=admin
FIHI_ADMIN_PASSWORD=change-me-to-a-long-passphrase
FIHI_ADMIN_EMAIL=you@example.com

# Public URL used in password-reset e-mails (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
FIHI_PUBLIC_BASE_URL=https://your-app.up.railway.app

# SMTP for password-reset e-mails (optional: if empty, the link is printed in the logs)
FIHI_SMTP_HOST=
FIHI_SMTP_PORT=587
FIHI_SMTP_USER=
FIHI_SMTP_PASSWORD=
FIHI_SMTP_USE_TLS=1
FIHI_EMAIL_FROM=

# Local previews only: fill an EMPTY database with the demo catalog (never in production)
# FIHI_SEED_DEMO=1
